# 复制为 .env 后按需修改。生产环境建议改用环境变量/密钥管理服务注入，不要把真实密钥写进文件。
APP_NAME=MAIC API
DEBUG=false

# 监听地址：容器/远程机器用 0.0.0.0；只在本机跑也可写 127.0.0.1
HOST=0.0.0.0
PORT=8001

# 所有业务接口统一前缀，前端 API_BASE 与 Nginx 反代都按 /api 配置
API_PREFIX=/api

# 允许跨域的前端来源，多个用英文逗号分隔；生产填真实前端域名，不要用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 课件数据库与产物根目录；留空时使用 server/outputs。生产务必指向持久化目录
MAIC_OUTPUT_DIR=

# 大模型配置（app/agent/agent.py 读取）
MODEL_NAME=your-model-name
API_KEY=your-api-key
API_BASE_URL=https://your-model-endpoint/v1

# HTML 渲染评审用的模型密钥（可复用 API_KEY；未使用可留空）
OPENAI_API_KEY=

# 资源文本化：MinerU 云端解析接口
MINERU_API_KEY=your-mineru-api-key
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm

# 向量检索：Milvus 与embedding 服务
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
VECTOR_API_KEY=your-vector-api-key
VECTOR_MODEL=text-embedding-v4
VECTOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 联网搜索（课件讨论在课件不足时兜底使用）
TAVILY_API_KEY=your-tavily-api-key

# 讨论可选配置：留空使用默认值
DISCUSSION_CONTEXT_CHARS=16000
DISCUSSION_HISTORY_TURNS=8
DISCUSSION_WEB_RESULTS=3

# HTML 评审渲染（auto / playwright / cli；生产镜像通常需指定浏览器路径）
HTML_CHECK_ENGINE=auto
HTML_CHECK_BROWSER=
HTML_CHECK_TIMEOUT=60
HTML_CHECK_MAX_TOKENS=8000
